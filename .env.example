## PayPal
# Create an app in the PayPal Developer Dashboard and paste the client id here.
VITE_PAYPAL_CLIENT_ID=""

# PayPal Client Secret (backend only - do NOT commit this)
PAYPAL_CLIENT_SECRET=""

## Currency (PayPal + UI)
VITE_CURRENCY=USD

## Tax
# Configure tax as a decimal rate (e.g. 0.089 for 8.9%). Keep 0 for no tax.
VITE_TAX_RATE=0

## Email Service (Resend)
# Get your API key from https://resend.com
RESEND_API_KEY=""

## App URL (for CORS)
VITE_APP_URL="http://localhost:5173"
